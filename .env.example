# ==========================================
# NUBAGLOW APP - VARIABLES DE ENTORNO (EJEMPLO)
# Copiar este archivo a .env y completar los valores reales.
# NUNCA subir el archivo .env al repositorio.
# ==========================================

# Servidor Backend
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Base de datos relacional (PostgreSQL en Supabase)
# Formato: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:tu_password_aqui@db.tu_proyecto.supabase.co:5432/postgres

# Seguridad y Autenticacion (JWT)
JWT_SECRET=tu_clave_secreta_jwt_minimo_32_caracteres_aleatorios
JWT_REFRESH_SECRET=tu_clave_secreta_jwt_refresh_distinta_y_larga
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Notificaciones por Correo (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@tudominio.com
SMTP_PASS=tu_app_password_o_clave_smtp
SMTP_FROM="NubaGlow" <notificaciones@tudominio.com>

# Pagos: plazo maximo para acreditar pagos Pendiente/En verificacion (horas)
PAGO_VENCIMIENTO_HORAS=24

# Reglas de negocio de envio (las define el negocio, no son requisitos fijos)
# Costo fijo en Bs. cuando el subtotal no alcanza el umbral de envio gratis.
ENVIO_COSTO=15
# Subtotal minimo en Bs. desde el cual el envio es gratuito.
ENVIO_GRATIS_DESDE=200

# Datos de cobro simulados para QR y deposito bancario (NO usar datos reales)
COBRO_BANCO=Banco Demo Academico
COBRO_TITULAR=NubaGlow Simulacion Academica
COBRO_CUENTA=0000000000
COBRO_REFERENCIA_QR=NB-QR-DEMO-2026

# Alertas internas (Telegram Bot API)
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_CHAT_ID=tu_telegram_chat_id_operaciones

# Asistente IA (Gemini API o Anthropic Claude)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
# ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui
